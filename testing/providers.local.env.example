# Copy to .gate/providers.local.env (gitignored) — the real accounts behind gate G21
# (scripts/gate_g21.sh, docs/PROVIDERS_CONFORMANCE.md). Never commit the real file.
#
# PROVIDER_ACCOUNTS is a comma-separated list of  provider:address:auth  entries, where
#   provider = gmail | outlook | yahoo | icloud   (also accepted: fastmail, zoho, gmx, generic)
#   auth     = password_env=VAR   the app password is in environment variable VAR (defined below)
#            | oauth              OAuth2 (Gmail → Google client id, Outlook → Entra client id;
#                                 the client ids live in .gate/config.local.env as
#                                 GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET / MS_OAUTH_CLIENT_ID)
#
# The gate adds password accounts to its own profile (.gate/profiles/g21) by itself. OAuth
# accounts need ONE interactive consent in a browser; the gate prints the exact command
# (`sealbox account add --email … --oauth google|microsoft --open-browser`) and exits 3 until done.
# Every address here must also be listed in TEST_ACCOUNTS in .gate/config.local.env, because the
# suite sends encrypted test mail to the account itself.

PROVIDER_ACCOUNTS="gmail:you@gmail.com:oauth,outlook:you@outlook.com:oauth,yahoo:you@yahoo.com:password_env=YAHOO_APP_PW,icloud:you@icloud.com:password_env=ICLOUD_APP_PW"

# App passwords (generate them in the provider's security settings; see the conformance doc):
YAHOO_APP_PW=
ICLOUD_APP_PW=
# Optional extras:
# GMAIL_APP_PW=        # only if you prefer "gmail:you@gmail.com:password_env=GMAIL_APP_PW" over OAuth
# FASTMAIL_APP_PW=
