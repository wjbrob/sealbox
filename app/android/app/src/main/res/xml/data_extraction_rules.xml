<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup or device transfer of the profile or of flutter_secure_storage's
     keystore-wrapped values: a restored blob without its Keystore key is useless and the
     profile must not leave the device unencrypted. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
