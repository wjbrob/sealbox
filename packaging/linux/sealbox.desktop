[Desktop Entry]
Type=Application
Version=1.0
Name=Sealbox
GenericName=Encrypted Mail
Comment=End-to-end encrypted email on the mailbox you already have
Exec=sealbox %u
TryExec=sealbox
Icon=sealbox
Terminal=false
Categories=Network;Email;Office;
Keywords=email;mail;encryption;openpgp;autocrypt;
MimeType=x-scheme-handler/mailto;
StartupNotify=true
StartupWMClass=sealbox_app
