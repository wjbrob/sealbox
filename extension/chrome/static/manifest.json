{
  "manifest_version": 3,
  "name": "Sealbox for Gmail",
  "short_name": "Sealbox",
  "version": "0.1.0",
  "description": "End-to-end encrypted Gmail with OpenPGP (PGP/MIME + Autocrypt). Uses only the documented Gmail REST API.",
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Sealbox",
    "default_icon": {
      "48": "icon-48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "compose.html",
        "reader.html"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'none'; connect-src https:; frame-src 'self'; form-action 'none'; base-uri 'none'"
  }
}
