<?xml version="1.0" encoding="UTF-8"?>
<!-- Sealbox Outlook add-in (gate G28). Add-in only manifest (XML), Mailbox 1.8.
     Bodies and headers go through Office.js only (item.body.getAsync/setAsync,
     getAllInternetHeadersAsync, getAttachmentContentAsync); the wasm core runs in the taskpane.
     https://localhost:3000 is the development host (`npx http-server dist/outlook-addin -S`
     or any HTTPS static host) — replace it with the production origin before deploying. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>6f1d3c2e-8b4a-4f7e-9c1d-5a2b7e9f0c31</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Sealbox</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Sealbox"/>
  <Description DefaultValue="End-to-end encrypted mail with OpenPGP: encrypt while composing, decrypt while reading."/>
  <IconUrl DefaultValue="https://localhost:3000/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/icon-128.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/help.html"/>
  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.8"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.8">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="sealboxReadGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="sealboxReadButton">
                  <Label resid="ReadButtonLabel"/>
                  <Supertip>
                    <Title resid="ReadButtonLabel"/>
                    <Description resid="ReadButtonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="TaskpaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="sealboxComposeGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="sealboxComposeButton">
                  <Label resid="ComposeButtonLabel"/>
                  <Supertip>
                    <Title resid="ComposeButtonLabel"/>
                    <Description resid="ComposeButtonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="TaskpaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://localhost:3000/icon-16.png"/>
        <bt:Image id="Icon32" DefaultValue="https://localhost:3000/icon-32.png"/>
        <bt:Image id="Icon80" DefaultValue="https://localhost:3000/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="TaskpaneUrl" DefaultValue="https://localhost:3000/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Sealbox"/>
        <bt:String id="ReadButtonLabel" DefaultValue="Decrypt"/>
        <bt:String id="ComposeButtonLabel" DefaultValue="Encrypt"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ReadButtonTip" DefaultValue="Decrypt and verify this OpenPGP message with Sealbox."/>
        <bt:String id="ComposeButtonTip" DefaultValue="Encrypt and sign this message to its recipients with Sealbox."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
